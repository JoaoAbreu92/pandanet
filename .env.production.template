# Configuração de Produção - PandaNet
# Substitua os valores com suas configurações reais

# ============================================
# SUPABASE SELF-HOSTED (Frontend)
# ============================================
# Use o IP público da sua VPS
VITE_SUPABASE_URL=http://SEU_IP_VPS:8000
# Copie do arquivo .env do Supabase (~/supabase/docker/.env)
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# ============================================
# SUPABASE (Backend - usa nome do container)
# ============================================
# O backend usa o nome do container na rede Docker
SUPABASE_URL=http://supabase-kong:8000
# Copie do arquivo .env do Supabase (~/supabase/docker/.env)
SUPABASE_SERVICE_KEY=sua_service_role_key_aqui

# ============================================
# APLICAÇÃO
# ============================================
COMPANY_ID=1
PORT=3000

# ============================================
# GEMINI API (Opcional)
# ============================================
GEMINI_API_KEY=sua_gemini_api_key_aqui

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 1. Nunca commite este arquivo com valores reais no Git
# 2. As keys do Supabase estão em ~/supabase/docker/.env
# 3. Para gerar JWT Secret: openssl rand -base64 32
# 4. O backend usa supabase-kong:8000 (rede Docker interna)
# 5. O frontend usa SEU_IP_VPS:8000 (acesso externo)
